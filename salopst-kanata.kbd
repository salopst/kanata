#|---
title: Portable Kanata key remapping configuration (v4, deflayermap)
author: salopst
date: 2023-10-01
lastmod: 2026-11-16
---|#

;; US ANSI replacement board for ThinkPad T14 G3 (FRU 5N21D68058)
;; 102d (ISO key) doubles as an additional left shift.
;;
;; Behaviour
;;   caps  tap = esc, hold = ctrl
;;   ret   tap = ret, hold = ctrl
;;   space tap = space, hold = nav layer
;;   shift tap = ( or ), hold = shift
;;   F11 / F12 select QWERTY / Colemak (hold space for real F11 / F12)
;;
;; Tuning: accidental holds -> lower the tap value; sluggish holds -> lower the
;; hold value in 25ms steps.

(defcfg
  process-unmapped-keys yes
  ;; concurrent-tap-hold yes   ;; try this if overlapping tap-holds misfire
  ;; log-layer-changes yes     ;; handy while debugging
)

;; Empty on purpose: layers below use deflayermap, which names keys directly.
(defsrc)

(defvar
  tap-ms    120
  hold-ms   190
  stap-ms   100   ;; shifts: shorter tap window so Shift+letter never types a paren
  shold-ms  175
)

(defalias
  nav (layer-while-held nav)
  qwe (layer-switch qwerty)
  col (layer-switch colemak)

  spc (tap-hold-release $hold-ms $hold-ms spc @nav)
  cbs (tap-hold-release $tap-ms  $hold-ms esc lctl)
  ret (tap-hold-release $tap-ms  $hold-ms ret rctl)
  lpa (tap-hold-press   $stap-ms $shold-ms S-9 lsft)
  rpa (tap-hold-press   $stap-ms $shold-ms S-0 rsft)

  ;; Hebrew niqqud (nav layer + a/s/d)
  ha (unicode ֳ)   ;; U+05B3 hataf qamats
  hs (unicode ֱ)   ;; U+05B1 hataf segol
  hd (unicode ֲ)   ;; U+05B2 hataf patah
)

;; First layer defined = starting layer.
(deflayermap (qwerty)
  f11  @qwe
  f12  @col
  caps @cbs
  ret  @ret
  lsft @lpa
  102d lsft
  rsft @rpa
  spc  @spc
)

;; Only the keys that differ from QWERTY are listed.
(deflayermap (colemak)
  f11  @qwe
  f12  @col
  caps @cbs
  ret  @ret
  lsft @lpa
  102d lsft
  rsft @rpa
  spc  @spc
  e f   r p   t g   y j   u l   i u   o y   p ;
  s r   d s   f t   g d   j n   k e   l i   ;  o
  n k
)

;; Held-space layer. Unlisted keys fall through to whichever base layer is
;; active, so it works the same on QWERTY and Colemak.
(deflayermap (nav)
  f11 f11
  f12 f12
  1 M-1   2 M-2   3 M-3   4 M-4   5 M-5   6 M-6   7 M-7   8 M-8   9 M-9
  a @ha   s @hs   d @hd
  h left  j down  k up    l rght
)
