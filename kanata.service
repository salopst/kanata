# ---
# title:    Katata keyboard mapper service
# author:   salopst
# date:     2026-02-08
# lastmod:  2026-02-08
# file:     $XDG_CONFIG_HOME/systemd/user/kanata.service
# ---


[Unit]
Description=Kanata keyboard remapper
Documentation=https://github.com/jtroo/kanata

[Service]
ExecStart=%h/.cargo/bin/kanata --cfg %h/.config/kanata/salopst-kanata.kbd
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
